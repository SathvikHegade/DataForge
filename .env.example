# DataForge Environment Variables

# Backend
PROJECT_NAME=DataForge
API_V1_STR=/api/v1
API_PORT=8000
ENVIRONMENT=development
SECRET_KEY=dataforge-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database
# Default uses PostgreSQL. In local standalone test mode without postgres, can use sqlite:///./dataforge.db
DATABASE_URL=postgresql://dataforge:dataforge_secret@localhost:5432/dataforge_db
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=dataforge_secret
POSTGRES_DB=dataforge_db
# For Docker Compose:
# DATABASE_URL=postgresql://dataforge:dataforge_secret@postgres:5432/dataforge_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
# For Docker Compose:
# REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO / S3)
STORAGE_BACKEND=s3  # "s3" or "local"
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=dataforge-datasets
S3_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Local storage fallback directory
LOCAL_STORAGE_DIR=./data_storage

# Upload & Processing Limits
MAX_UPLOAD_SIZE_MB=500
MAX_PREVIEW_ROWS=1000
CHUNK_SIZE_ROWS=50000

# External Dataset Integrations (Optional)
# For Kaggle imports: set username and key (or KAGGLE_API_TOKEN)
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=

# For Hugging Face private/gated datasets or higher rate limits
HF_TOKEN=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000
